{
  "name": "jarvisgram",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @jarvisgram/db generate",
    "db:migrate": "pnpm --filter @jarvisgram/db migrate:dev",
    "db:deploy": "pnpm --filter @jarvisgram/db migrate:deploy",
    "dev:web": "pnpm --filter @jarvisgram/web dev",
    "dev:mcp": "pnpm --filter @jarvisgram/mcp dev"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "^22.10.0"
  }
}
