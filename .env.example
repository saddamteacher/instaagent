# Jarvisgram — muhit o'zgaruvchilari namunasi. Haqiqiy qiymatlarni .env / .env.local ga yozing (git'ga tushmaydi).

# Postgres (packages/db, apps/mcp, apps/web hammasi bir bazadan foydalanadi)
DATABASE_URL="postgresql://jarvis:jarvis@localhost:5432/jarvisgram"
# Testlar uchun alohida baza (nomida "test" bo'lishi shart — testlar uni tozalaydi)
TEST_DATABASE_URL="postgresql://jarvis:jarvis@localhost:5432/jarvisgram_test"

# Veb-ilovaning tashqi manzili (OAuth rozilik sahifasi shu yerda)
WEB_PUBLIC_URL="http://localhost:3000"
# MCP serverining tashqi manzili (OAuth issuer). Konnektor URL = MCP_PUBLIC_URL + /mcp
# Render'da berilmasa RENDER_EXTERNAL_URL ishlatiladi.
MCP_PUBLIC_URL="http://localhost:3001"

# Interfeys vaqt mintaqasi
NEXT_PUBLIC_TZ="Asia/Tashkent"

# --- 3-bosqich: rasmiy Instagram API (Instagram Login, graph.instagram.com) ---
# Meta for Developers'da Instagram ilovasi (Instagram API with Instagram Login) yarating.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Ilovada ro'yxatdan o'tkazilgan qaytish manzili:
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/instagram/callback"
IG_GRAPH_VERSION="v26.0"
# Graph tokenlarini bazada shifrlash kaliti (web va mcp'da BIR XIL): openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
